+// circle-touch-pointer.patch: a single-touch device, read only, logged at NOTICE: is there a multi-touch mode? Its
+// configurations (all interfaces and alternate settings, hex) and its feature reports 1..5 (GET_REPORT: reads, a
+// stall answers an ID it does not have). Nothing is written.
+void CUSBTouchScreenDevice::ProbeMultiTouch (const hiddig::Layout &Layout)
+{
+	const TUSBDeviceDescriptor *pDevDesc = GetDevice ()->GetDeviceDescriptor ();
+	unsigned nConfigs = pDevDesc ? pDevDesc->bNumConfigurations : 0;
+	LOGNOTE ("probe: single touch (%u contact(s) a report); %u configuration(s)", Layout.Contacts, nConfigs);
+
+	DMA_BUFFER (u8, Buffer, 512);
+	for (unsigned i = 0; i < nConfigs && i < 4; i++)
+	{
+		if (GetHost ()->GetDescriptor (GetEndpoint0 (), DESCRIPTOR_CONFIGURATION, i, Buffer, 9) != 9)
+		{
+			LOGNOTE ("probe: configuration %u: no descriptor", i);
+			continue;
+		}
+		unsigned nTotal = Buffer[2] | Buffer[3] << 8;
+		if (nTotal > sizeof Buffer) nTotal = sizeof Buffer;
+		int nGot = GetHost ()->GetDescriptor (GetEndpoint0 (), DESCRIPTOR_CONFIGURATION, i, Buffer, nTotal);
+		if (nGot <= 0) continue;
+
+		CString What;
+		What.Format ("probe: configuration %u (%u interface(s))", i, Buffer[4]);
+		LogHex (From, What, Buffer, nGot);
+		for (int j = 0; j + 1 < nGot && Buffer[j] >= 2; j += Buffer[j])	// the interfaces, alternate settings
+		{
+			if (Buffer[j + 1] == DESCRIPTOR_INTERFACE && j + 8 < nGot)
+			{
+				LOGNOTE ("probe: interface %u alt %u: class %u-%u-%u, %u endpoint(s)", Buffer[j + 2],
+					 Buffer[j + 3], Buffer[j + 5], Buffer[j + 6], Buffer[j + 7], Buffer[j + 4]);
+			}
+		}
+	}
+
+	for (unsigned nID = 1; nID <= 5; nID++)
+	{
+		int nGot = GetHost ()->ControlMessage (GetEndpoint0 (),
+						       REQUEST_IN | REQUEST_CLASS | REQUEST_TO_INTERFACE,
+						       GET_REPORT, (REPORT_TYPE_FEATURE << 8) | nID,
+						       GetInterfaceNumber (), Buffer, 64);
+		if (nGot < 0)
+		{
+			LOGNOTE ("probe: feature report %u: none (stall or error)", nID);
+			continue;
+		}
+		CString What;
+		What.Format ("probe: feature report %u", nID);
+		LogHex (From, What, Buffer, (unsigned) nGot);
+	}
+}
