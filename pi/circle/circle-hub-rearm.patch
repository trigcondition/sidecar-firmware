 		usStatusBitmap |= (u16) m_pStatusChangeBuffer[1] << 8;
 	}
 
+	if (m_bStatusError)
+	{
+		// circle-hub-rearm.patch: the request ended in an error, so the buffer holds nothing. A halted xHCI
+		// endpoint is reset (it takes no new transfer before that) and the request is armed again.
+		m_bStatusError = FALSE;
+		CLogger::Get ()->Write (FromHub, LogWarning, "Status change request failed (error %u, %u so far): re-armed",
+					s_nStatusLastError, s_nStatusErrors);
+#if RASPPI >= 4
+		CXHCIEndpoint *pXHCI = m_pInterruptEndpoint->GetXHCIEndpoint ();
+		if (   pXHCI != 0
+		    && pXHCI->GetEPState () >= 2)	// halted, stopped or error
+		{
+			if (!pXHCI->ResetFromHalted ())
+			{
+				CLogger::Get ()->Write (FromHub, LogError, "Cannot reset the status change endpoint");
+			}
+		}
+#endif
+		// Nothing is sent to the hub itself here: right after such an error it may not answer yet, and a failed
+		// port read below is a LogPanic (an earlier version that cleared the halt on the hub and read every port
+		// at this point made the Pi reboot on about one Rytm OS update in six). A change the hub latched
+		// meanwhile stays in its change bits, and the hub reports it again once the request is armed.
+		if (!StartStatusChangeRequest ())
+		{
+			CLogger::Get ()->Write (FromHub, LogError, "Cannot restart request");
+
+			s_nRearmFailures++;
+			ScheduleRecovery ();
+		}
