@@ -711,5 +773,47 @@
 	if (!StartStatusChangeRequest ())
 	{
 		CLogger::Get ()->Write (FromHub, LogError, "Cannot restart request");
+
+		s_nRearmFailures++;			// circle-hub-rearm.patch: tried again later, from a timer
+		ScheduleRecovery ();
+	}
+}
+
+// circle-hub-rearm.patch: one recovery at a time, 250 ms after the first error, backing off to 1 s; after 50 errors
+// in a row (no good completion between) the hub is given up, as Circle did before, with a line saying so.
+void CUSBStandardHub::ScheduleRecovery (void)
+{
+	if (m_hRecoveryTimer != 0)
+	{
+		return;					// one is due already
+	}
+
+	unsigned nErrors = ++m_nConsecErrors;
+	if (nErrors > 50)
+	{
+		if (nErrors == 51)
+		{
+			CLogger::Get ()->Write (FromHub, LogError, "Status change request failed 50 times in a row: given up");
+		}
+
+		return;
+	}
+
+	unsigned nDelayMs = 250 * nErrors;
+	if (nDelayMs > 1000)
+	{
+		nDelayMs = 1000;
 	}
+
+	m_hRecoveryTimer = CTimer::Get ()->StartKernelTimer (MSEC2HZ (nDelayMs), RecoveryTimer, 0, this);
+}
+
+void CUSBStandardHub::RecoveryTimer (TKernelTimerHandle hTimer, void *pParam, void *pContext)
+{
+	CUSBStandardHub *pThis = (CUSBStandardHub *) pContext;
+	assert (pThis != 0);
+
+	pThis->m_hRecoveryTimer = 0;
+	pThis->m_bStatusError = TRUE;
+	pThis->GetHost ()->PortStatusChanged (pThis);
 }
