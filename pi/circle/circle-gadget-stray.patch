+// ---- circle-gadget-stray ----------------------------------------------------------------------------------------
+//
+// While a request waits for its deferred answer (circle-gadget-mirror) nothing is armed on EP0. A SETUP the host sends
+// then (it gave up on the request) is still taken by the core: in buffer DMA mode it is written where DOEPDMA0 points,
+// just past the last OUT transfer (the SETUP before, or an OUT data stage), and SETUP done is raised. FinishTransfer()
+// asserted on it (the Pi 4 at a live switch to the mirror, 2026-11-06, serial: dwusbgadgetendpoint.cpp(550)). The
+// SETUP is read back from there when that lies in one of EP0's buffers, and handled as any (it ends the deferred
+// request, OnControlMessage); else it is dropped, the deferred request aborted and SETUP reception armed again.
+// Nothing else of EP0's flow changes: Circle's single transfer, as before.
+
+volatile unsigned CDWUSBGadgetEndpoint0::s_nSetupAborts = 0;
+
+const u8 *CDWUSBGadgetEndpoint0::FindStraySetup (void)
+{
+	CDWHCIRegister OutEPDMAAddress (DWHCI_DEV_OUT_EP_DMA_ADDR (0));
+	u32 nEnd = OutEPDMAAddress.Read ();		// just past the SETUP the core wrote
+	const struct { const u8 *p; size_t n; } Buf[] =
+	{
+		{m_OutBuffer, sizeof m_OutBuffer},
+		{m_InBuffer, sizeof m_InBuffer},
+		{(const u8 *) m_DummyBuffer, sizeof m_DummyBuffer}
+	};
+	for (const auto &b : Buf)
+	{
+		u32 nStart = (u32) BUS_ADDRESS ((uintptr) b.p);
+		if (nEnd >= nStart + sizeof (TSetupData) && nEnd <= nStart + b.n)
+		{
+			const u8 *p = b.p + (nEnd - nStart - sizeof (TSetupData));
+			InvalidateDataCacheRange ((uintptr) p, sizeof (TSetupData));
+
+			return p;
+		}
+	}
+
+	return nullptr;
+}
+
+void CDWUSBGadgetEndpoint0::OnStraySetup (void)
+{
+	const u8 *p = FindStraySetup ();
+	if (p != nullptr)
+	{
+		u8 Setup[sizeof (TSetupData)];
+		memcpy (Setup, p, sizeof Setup);
+		memcpy (m_OutBuffer, Setup, sizeof Setup);	// where OnControlMessage() reads it
+		CleanAndInvalidateDataCacheRange ((uintptr) m_OutBuffer, sizeof Setup);
+		OnControlMessage ();
+
+		return;
+	}
+
+	CLogger::Get ()->Write (FromEP0, LogWarning, "SETUP with nothing armed, not found (DMA past our buffers): dropped");
+	if (m_State == StateDeferred)
+	{
+		m_pGadget->OnControlAborted ();
+	}
+	m_State = StateIdle;
+	if (!IsTransferActive ())
+	{
+		BeginTransfer (TransferSetupOut, m_OutBuffer, sizeof (TSetupData));
+	}
+}
