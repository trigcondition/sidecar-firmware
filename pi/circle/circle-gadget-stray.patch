+// circle-gadget-stray (IRQ level): a completion for this EP while no transfer is armed on it (TransferUnknown),
+// acknowledged by the caller: counted, logged the first time and then at powers of two
+volatile unsigned CDWUSBGadgetEndpoint::s_nStray = 0;
 
+void CDWUSBGadgetEndpoint::NoteStray (const char *pWhat)
+{
+	unsigned n = s_nStray + 1;
+	s_nStray = n;
+	if ((n & (n - 1)) == 0)
+	{
+		LOGWARN ("EP%u: %s with no transfer armed (%u so far)", m_nEP, pWhat, n);
+	}
+}
