+// circle-gadget-mirror: the answer to a request OnControlRequest() deferred
+boolean CDWUSBGadgetEndpoint0::CompleteDeferred (const void *pData, int nLength)
+{
+	if (m_State != StateDeferred)
+	{
+		return FALSE;
+	}
+
+	if (nLength < 0)
+	{
+		m_State = StateIdle;
+
+		Stall (TRUE);
+		BeginTransfer (TransferSetupOut, m_OutBuffer, sizeof (TSetupData));
+
+		return TRUE;
+	}
+
+	if (!(m_SetupData.bmRequestType & REQUEST_IN))
+	{
+		m_bForwarded = TRUE;
+		m_State = StateInStatusPhase;
+		BeginTransfer (TransferDataIn, nullptr, 0);
+
+		return TRUE;
+	}
+
+	size_t nLen = (size_t) nLength;
+	if (nLen > m_SetupData.wLength)
+	{
+		nLen = m_SetupData.wLength;
+	}
+	if (nLen > BufferSize)
+	{
+		nLen = BufferSize;
+	}
+	if (nLen)
+	{
+		memcpy (m_InBuffer, pData, nLen);
+	}
+
+	m_State = StateInDataPhase;
+
+	m_nBytesLeft = nLen;
+	m_pBufPtr = m_InBuffer;
+
+	BeginTransfer (TransferDataIn, nLen ? m_pBufPtr : nullptr,
+		         m_nBytesLeft <= m_nMaxPacketSize
+		       ? m_nBytesLeft : m_nMaxPacketSize);
+
+	return TRUE;
+}
