+void CDWUSBGadget::RemoveEndpoint (unsigned nEP, CDWUSBGadgetEndpoint *pEP)
+{
+	assert (nEP <= NumberOfEPs);
+
+	if (nEP && m_pOutEP[nEP] == pEP)	// circle-gadget-mirror
+	{
+		m_pOutEP[nEP] = nullptr;
+
+		return;
+	}
+
+	assert (m_pEP[nEP] == pEP);
+	m_pEP[nEP] = nullptr;
+	if (nEP && m_pOutEP[nEP])		// the number's OUT EP back to the plain slot
+	{
+		m_pEP[nEP] = m_pOutEP[nEP];
+		m_pOutEP[nEP] = nullptr;
+	}
+}
+
+// circle-gadget-mirror
+boolean CDWUSBGadget::CompleteControl (const void *pData, int nLength)
+{
+	if (m_pEP[0] == nullptr)
+	{
+		return FALSE;
+	}
+
+	return static_cast<CDWUSBGadgetEndpoint0 *> (m_pEP[0])->CompleteDeferred (pData, nLength);
+}
