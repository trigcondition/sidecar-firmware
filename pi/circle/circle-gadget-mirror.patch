+			{
+				m_pOutEP[nEP] = pEP;
+			}
+			else
+			{
+				m_pOutEP[nEP] = m_pEP[nEP];
+				m_pEP[nEP] = pEP;
+			}
+
+			return;
+		}
+	}
 
