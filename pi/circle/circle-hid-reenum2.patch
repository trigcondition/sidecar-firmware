+	if (   nPortIndex >= m_nPorts
+	    || GetPowerSwitchMode () > HUB_POWER_MODE_INDIVIDUAL)
+	{
+		return FALSE;
+	}
+
+	if (GetHost ()->ControlMessage (GetEndpoint0 (),
+					REQUEST_OUT | REQUEST_CLASS | REQUEST_TO_OTHER,
+					CLEAR_FEATURE, PORT_POWER, nPortIndex+1, 0, 0) < 0)
+	{
+		CLogger::Get ()->Write (FromHub, LogError, "Cannot power off port %u", nPortIndex+1);
+
+		return FALSE;
+	}
+
+	CLogger::Get ()->Write (FromHub, LogNotice, "Port %u powered off for %u ms (%s switching)",
+				nPortIndex+1, nOffMs,
+				GetPowerSwitchMode () == HUB_POWER_MODE_INDIVIDUAL ? "individual" : "ganged");
+
+	m_bPowerIsOn = FALSE;			// EnumeratePorts () powers every port again, with its delay
+	m_bPortConfigured[nPortIndex] = FALSE;
+
+	CTimer::Get ()->MsDelay (nOffMs);
 
 	return TRUE;
 }
