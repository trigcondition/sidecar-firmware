+// circle-rp1dsi-warmrestart.patch: as Linux does before a reboot - the panel off and reset, the backlight and the touch
+// controller's supply off (a 5" at 0.3.1: without it the GT911 stayed silent after the restart)
+void CRPiTouchScreen2::PowerOff (void)
+{
+	if (!m_bRPiPanel2Initialized)
+		return;
+
+	m_Panel.PowerOff ();
+	m_Regulator.SetBacklight (0);
+	m_Regulator.GPIOWrite (CRPiPanel2Regulator::CTP_RESET, 0);
+	m_Regulator.GPIOWrite (CRPiPanel2Regulator::LCD_RESET, 0);
+	msleep (50);
+}
