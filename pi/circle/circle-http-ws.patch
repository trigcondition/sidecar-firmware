+// circle-http-ws.patch: the connection's send queue (0 if there is none)
+size_t CTransportLayer::GetBytesQueued (int hConnection) const
+{
+	assert (hConnection >= 0);
+	if (   hConnection >= (int) m_pConnection.GetCount ()
+	    || m_pConnection[hConnection] == 0)
+	{
+		return 0;
+	}
+
+	return ((CNetConnection *) m_pConnection[hConnection])->GetBytesQueued ();
+}
