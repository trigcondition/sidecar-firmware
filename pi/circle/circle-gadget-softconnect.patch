+	// circle-gadget-softconnect: the device leaves the bus and comes back, as a replug, with the descriptors and
+	// endpoints GetDescriptor() and AddEndpoints() give then (a gadget that changes what it is)
+#define CIRCLE_GADGET_SOFTCONNECT	1
+
+	/// \brief Leave the bus (task level): the endpoints are deactivated, the interrupts stay off until SoftConnect()
+	void SoftDisconnect (void);
+	/// \brief Back on the bus (task level, after SoftDisconnect(); the host needs some 100 ms to see the detach):
+	///	   the core is set up again, OnSuspend() removes the gadget's endpoints, AddEndpoints() makes them anew
+	boolean SoftConnect (void);
