+// circle-gadget-softconnect
+void CDWUSBGadget::SoftDisconnect (void)
+{
+	PeripheralEntry ();
+
+	CDWHCIRegister AHBConfig (DWHCI_CORE_AHB_CFG);
+	AHBConfig.Read ();
+	AHBConfig.And (~DWHCI_CORE_AHB_CFG_GLOBALINT_MASK);
+	AHBConfig.Write ();
+
+	CDWHCIRegister DeviceCtrl (DWHCI_DEV_CTRL);
+	DeviceCtrl.Read ();
+	DeviceCtrl.Or (DWHCI_DEV_CTRL_SOFT_DISCONNECT);
+	DeviceCtrl.Write ();
+
+	PeripheralExit ();
+
+	// the endpoints as at a reset of the configuration, EP0 last
+	for (unsigned i = 1; i <= NumberOfEPs; i++)
+	{
+		if (m_pEP[i])
+		{
+			m_pEP[i]->OnDeactivate ();
+		}
+		if (m_pOutEP[i])
+		{
+			m_pOutEP[i]->OnDeactivate ();
+		}
+	}
+	if (m_pEP[0])
+	{
+		m_pEP[0]->OnDeactivate ();
+	}
+
+	m_State = StateSuspended;
+}
+
+boolean CDWUSBGadget::SoftConnect (void)
+{
+	OnSuspend ();				// the gadget removes its endpoints
+
+	delete m_pEP[0];
+
+	PeripheralEntry ();
+
+	if (!InitCore ())
+	{
+		PeripheralExit ();
+
+		LOGERR ("Cannot initialize core");
+
+		return FALSE;
+	}
+
+	size_t nDescLength;
+	const TUSBDeviceDescriptor *pDeviceDesc =
+		reinterpret_cast<const TUSBDeviceDescriptor *> (
+			GetDescriptor (DESCRIPTOR_DEVICE << 8, 0, &nDescLength));
+	assert (pDeviceDesc);
+	new CDWUSBGadgetEndpoint0 (pDeviceDesc->bMaxPacketSize0, this);
+
+	AddEndpoints ();
+
+	m_State = StateSuspended;
+
+	CDWHCIRegister DeviceCtrl (DWHCI_DEV_CTRL);
+	DeviceCtrl.Read ();
+	DeviceCtrl.And (~DWHCI_DEV_CTRL_SOFT_DISCONNECT);
+	DeviceCtrl.Write ();
+
+	CDWHCIRegister AHBConfig (DWHCI_CORE_AHB_CFG);
+	AHBConfig.Read ();
+	AHBConfig.Or (DWHCI_CORE_AHB_CFG_GLOBALINT_MASK);
+	AHBConfig.Write ();
+
+	PeripheralExit ();
+
+	return TRUE;
+}
