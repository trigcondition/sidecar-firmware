diff -ruN a/lib/usb/usbhostcontroller.cpp b/lib/usb/usbhostcontroller.cpp
--- a/lib/usb/usbhostcontroller.cpp
+++ b/lib/usb/usbhostcontroller.cpp
@@ -237,6 +237,41 @@
 	m_SpinLock.Release ();
 }
 
+// circle-hub-rearm2.patch: a hub that is deleted drops the events it queued. Its recovery timer queues one after an
+// error, and a hub that is unplugged gets errors, so an event of a hub deleted meanwhile (by its parent's port change,
+// handled with the spin lock released) would otherwise reach HandlePortStatusChange() on freed memory.
+void CUSBHostController::RemovePortStatusEvents (CUSBStandardHub *pHub)
+{
+	assert (pHub != 0);
+
+	if (!m_bPlugAndPlay)
+	{
+		return;
+	}
+
+	m_SpinLock.Acquire ();
+
+	TPtrListElement *pElement = m_HubList.GetFirst ();
+	while (pElement != 0)
+	{
+		TPtrListElement *pNext = m_HubList.GetNext (pElement);
+
+		TPortStatusEvent *pEvent = (TPortStatusEvent *) m_HubList.GetPtr (pElement);
+		assert (pEvent != 0);
+		if (   !pEvent->bFromRootPort
+		    && pEvent->pHub == pHub)
+		{
+			m_HubList.Remove (pElement);
+
+			delete pEvent;
+		}
+
+		pElement = pNext;
+	}
+
+	m_SpinLock.Release ();
+}
+
