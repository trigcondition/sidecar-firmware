diff --color -ruN a/lib/usb/usbdevicefactory.cpp b/lib/usb/usbdevicefactory.cpp
--- a/lib/usb/usbdevicefactory.cpp	2026-10-24 19:05:04
+++ b/lib/usb/usbdevicefactory.cpp	2026-10-24 19:06:20
@@ -55,7 +55,57 @@
 #include <circle/usb/usbserialpl2303.h>
 #include <circle/usb/usbserialft231x.h>
 #include <circle/usb/usbtouchscreen.h>
+#include <circle/usb/hiddigitizer.h>
 
+#ifndef EXCLUDE_USB_TOUCHSCREEN
+// circle-touch.patch: does this boot keyboard/mouse interface carry a touch screen? Cheap HDMI panels (GeeekPi 7",
+// 0416:c169 "TSTP MTouch") declare their only HID interface a boot keyboard and send multi-touch digitizer reports
+// on it. Yes when its report descriptor has a usable Digitizer Touch Screen / Pen application (hiddigitizer.h), or
+// for the known panels by vendor/product (then CUSBTouchScreenDevice logs the descriptor if it cannot use it).
+// A descriptor that names the Digitizer page but has nothing usable is logged at NOTICE.
+static boolean IsBootTouchScreen (CUSBFunction *pParent)
+{
+	CString *pVendor = pParent->GetDevice ()->GetName (DeviceNameVendor);
+	assert (pVendor != 0);
+	boolean bQuirk = pVendor->Compare ("ven416-c169") == 0;		// GeeekPi 7" 1024x600 (TSTP MTouch)
+	delete pVendor;
+
+	CUSBFunction TempFunction (pParent);	// a copy: the configuration's descriptors are walked again later
+	TUSBHIDDescriptor *pHIDDesc = (TUSBHIDDescriptor *) TempFunction.GetDescriptor (DESCRIPTOR_HID);
+	if (pHIDDesc == 0 || pHIDDesc->wReportDescriptorLength == 0)
+	{
+		return bQuirk;
+	}
+
+	u16 usLength = pHIDDesc->wReportDescriptorLength;
+	DMA_BUFFER (u8, ReportDescriptor, usLength);
+	if (   TempFunction.GetHost ()->GetDescriptor (TempFunction.GetEndpoint0 (),
+			pHIDDesc->bReportDescriptorType, DESCRIPTOR_INDEX_DEFAULT,
+			ReportDescriptor, usLength,
+			REQUEST_IN | REQUEST_TO_INTERFACE, TempFunction.GetInterfaceNumber ())
+	    != usLength)
+	{
+		return bQuirk;
+	}
+
+	hiddig::Layout Layout;
+	if (hiddig::Parse (ReportDescriptor, usLength, &Layout))
+	{
+		pParent->GetDevice ()->LogWrite (LogNotice, "Touch screen on a boot HID interface: using the touch driver");
+
+		return TRUE;
+	}
+
+	if (!bQuirk && hiddig::MentionsDigitizer (ReportDescriptor, usLength))
+	{
+		CUSBTouchScreenDevice::LogHex ("ufactory", "digitizer page, no usable touch collection: report descriptor",
+					       ReportDescriptor, usLength);
+	}
+
+	return bQuirk;
+}
+#endif
+
