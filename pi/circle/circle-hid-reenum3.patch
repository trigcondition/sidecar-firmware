diff -ruN a/lib/usb/usbhiddevice.cpp b/lib/usb/usbhiddevice.cpp
--- a/lib/usb/usbhiddevice.cpp	2026-10-26 22:04:34
+++ b/lib/usb/usbhiddevice.cpp	2026-10-26 22:04:34
@@ -491,10 +491,24 @@
 				bPowerCycle ? " with a port power cycle" : "",
 				s_Budget.Tries, (unsigned) hidreenum::MaxTries);
 
+	// circle-hid-reenum3.patch: how long the main loop is held. The removal, the port reset (100 ms), the power
+	// cycle's 300 ms off and the hub's 510 ms power-good delay are all CTimer::MsDelay () busy waits inside
+	// Circle's synchronous hub code (the same path a hot-plug takes in UpdatePlugAndPlay ()), so it cannot be
+	// split over passes without rewriting that; IRQs keep running meanwhile. It is bounded instead: at most
+	// MaxTries per device until it is forgiven, each try ApartMs and a HoldMs given-up run after the last. The
+	// log line after the re-scan says what it cost on the device.
+	const unsigned nStartTicks = CTimer::GetClockTicks ();
+	s_nRemoved++;						// before: a caller's GetReEnumCount () must move
+								// whenever *this* may be gone, never only after
+
 	// The removal goes first even for the power cycle: cutting VBUS first would make its CLEAR_FEATURE
 	// PORT_ENABLE fail, and RemoveDeviceAt () then refuses to delete the device, which would leave a stale
 	// object on a dead port.
-	pDevice->RemoveDevice ();				// deletes pDevice and *this*
+	if (!pDevice->RemoveDevice ())				// deletes pDevice and *this*
+	{
+		// (the port could not be disabled: nothing was deleted, the re-scan below leaves the device as it is)
+		CLogger::Get ()->Write (FromUSBHID, LogWarning, "Re-enumeration: the device could not be removed");
+	}
 
 	if (   bPowerCycle
 	    && !pHub->PortPowerCycle (nPortIndex, ReEnumPowerOffMs))
@@ -513,6 +527,9 @@
 		pRootPort->ReScanDevices ();
 	}
 
+	CLogger::Get ()->Write (FromUSBHID, LogNotice, "Re-enumeration done: the main loop was held %u ms",
+				(CTimer::GetClockTicks () - nStartTicks) / 1000);	// circle-hid-reenum3.patch
+
 	return TRUE;
 #else
 	(void) Step;
@@ -520,9 +537,13 @@
 #endif
 }
 
+// circle-hid-reenum3.patch: the removals actually started (not the budget's Total, which also counts a try that
+// found nothing to remove), so a caller that sees no change knows the object it polled is still there.
+unsigned CUSBHIDDevice::s_nRemoved = 0;
+
 unsigned CUSBHIDDevice::GetReEnumCount (void)
 {
-	return s_Budget.Total;
+	return s_nRemoved;
 }
 
