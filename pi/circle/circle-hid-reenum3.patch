diff -ruN a/lib/usb/usbtouchscreen.cpp b/lib/usb/usbtouchscreen.cpp
--- a/lib/usb/usbtouchscreen.cpp	2026-10-26 22:04:34
+++ b/lib/usb/usbtouchscreen.cpp	2026-10-26 22:04:34
@@ -226,7 +226,18 @@
 
 void CUSBTouchScreenDevice::Poll (void)
 {
+	// circle-hid-reenum3.patch: CUSBHIDDevice::Poll () may re-enumerate the device (circle-hid-reenum.patch), and
+	// RemoveDevice () deletes the device with its functions - *this* among them - before Poll () returns, and the
+	// re-scan that follows may build the new panel's object at the same address. Everything below reads and writes
+	// members (the spin lock first: a lock word in freed memory can spin core 0 for ever, and core 0 also runs the
+	// network and the card), so it must not run on a re-enumeration's pass. GetReEnumCount () moves on every forced
+	// re-enumeration and is read before and after, as CSidecarDisplay::Update does with the touchN device.
+	const unsigned nReEnums = GetReEnumCount ();
 	CUSBHIDDevice::Poll ();
+	if (GetReEnumCount () != nReEnums)
+	{
+		return;					// *this* may have been deleted: touch nothing
+	}
 
 	// circle-touch-multi.patch: a device that repeats its report while held (SendsRepeats) and has sent none for
 	// ReleaseGapMs while a contact is down lost its release: every contact up (a long press keeps its repeats coming)
