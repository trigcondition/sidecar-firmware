 }
 
+// circle-midi-reset2: is the OUT endpoint halted on the xHC (state 2, 3 or 4)?
+boolean CUSBMIDIHostDevice::OutHaltedHandler (void *pParam)
+{
+	CUSBMIDIHostDevice *pThis = static_cast<CUSBMIDIHostDevice *> (pParam);
+	assert (pThis);
+#if RASPPI >= 4
+	CXHCIEndpoint *pXHCI = pThis->m_pEndpointOut != 0 ? pThis->m_pEndpointOut->GetXHCIEndpoint () : 0;
+	return pXHCI != 0 && pXHCI->GetEPState () >= 2;
+#else
+	return FALSE;
+#endif
+}
+
 // circle-midi-reset.patch: a transfer error halts a non-isochronous xHCI endpoint, and every later send on it fails (or
 // times out): reset it. Not while an asynchronous send is in flight (its URB is the completion's to free).
 boolean CUSBMIDIHostDevice::ResetOutHandler (void *pParam)
@@ -264,7 +278,16 @@
 		return FALSE;
 	}
 	CXHCIEndpoint *pXHCI = pThis->m_pEndpointOut->GetXHCIEndpoint ();
-	if (pXHCI == 0 || pXHCI->GetEPState () < 2 || !pXHCI->ResetFromHalted ())	// 2 halted, 3 stopped, 4 error
+	if (pXHCI == 0 || pXHCI->GetEPState () < 2)		// 2 halted, 3 stopped, 4 error
+	{
+		return FALSE;
+	}
+	// circle-midi-reset2: the device's side first. The reset sets the host's data toggle to DATA0, and the device's must
+	// follow, or it drops the next packet as a repeat; its answer does not matter.
+	pThis->GetHost ()->ControlMessage (pThis->GetEndpoint0 (), REQUEST_OUT | REQUEST_TO_ENDPOINT, CLEAR_FEATURE,
+					   ENDPOINT_HALT, pThis->m_pEndpointOut->GetNumber (), 0, 0);
+	// ResetFromHalted returns TRUE for a command that failed (it returns !code): the state after it decides
+	if (!pXHCI->ResetFromHalted () || pXHCI->GetEPState () == 2 || pXHCI->GetEPState () == 4)
 	{
 		return FALSE;
 	}
