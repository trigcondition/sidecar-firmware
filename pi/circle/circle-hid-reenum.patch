+// circle-hid-reenum.patch: the device's place in the USB tree - the root hub port it hangs off and the route string
+// through the hubs below it. A re-enumeration keeps both (they are the physical topology) while the CUSBDevice and
+// this CUSBFunction are destroyed and made anew, so this is what the re-enumeration budget is keyed on. 0: unknown.
+unsigned CUSBHIDDevice::ReEnumKey (void) const
+{
+#if RASPPI >= 4
+	CUSBDevice *pDevice = GetDevice ();
+	if (pDevice == 0)
+	{
+		return 0;
+	}
+
+	unsigned nPortID = pDevice->GetRootHubPortID ();
+	if (nPortID == 0)
+	{
+		return 0;
+	}
+
+	return (nPortID << 20) | (pDevice->GetRouteString () & 0xFFFFF);
+#else
+	return 0;
+#endif
+}
+
+// circle-hid-reenum.patch: the software replug. Called from Poll () only, which runs on the main loop: this resets a
+// hub port, frees and allocates an xHCI slot and enumerates a device, none of which may happen in a completion
+// routine (IRQ).
+//
+// CUSBDevice::RemoveDevice () is what CUSBStandardHub runs when a device is unplugged: it disables the hub port,
+// frees the xHCI slot and deletes the device with its functions. The parent's ReScanDevices () is what it runs when
+// one is plugged in: it resets the port and enumerates whatever answers, with a new slot ID and a new device
+// context. The two in a row are therefore the hot-plug path the host controller already takes, not a new one, and
+// they are the least that gives the fresh address and context an endpoint reset provably cannot.
+//
+// The device owns this CUSBFunction, so RemoveDevice () deletes *this*. Everything needed afterwards is taken into
+// locals or the statics above first, and no member of this object is read or written once RemoveDevice () has been
+// called. Returns TRUE when the device was removed - the caller must then return at once.
+boolean CUSBHIDDevice::TryReEnumerate (void)
+{
+#if RASPPI >= 4
+	unsigned nKey = ReEnumKey ();
+	if (nKey == 0)
+	{
+		return FALSE;				// no stable identity: nothing to bound the budget with
+	}
+
+	if (nKey != s_nReEnumKey)
+	{
+		s_nReEnumKey = nKey;			// another device: it gets its own budget
+		s_nReEnumTries = 0;
+		s_bReEnumExhausted = FALSE;
+	}
+
+	if (s_bReEnumExhausted)
+	{
+		return FALSE;				// given up for good; the endpoint-level loop carries on
+	}
+
+	CUSBDevice *pDevice = GetDevice ();
+	assert (pDevice != 0);
+	CUSBStandardHub *pHub = pDevice->GetParentHub ();	// the parent outlives us; one of the two is set
+	CUSBHCIRootPort *pRootPort = pDevice->GetParentRootPort ();
+	if (   pHub == 0
+	    && pRootPort == 0)
+	{
+		return FALSE;				// nothing left that could enumerate it again
+	}
+
+	if (++s_nReEnumTries >= MaxReEnums)
+	{
+		s_bReEnumExhausted = TRUE;		// this is the last try for this device
+	}
+	s_nReEnums++;
+
+	CLogger::Get ()->Write (FromUSBHID, LogWarning,
+				"Report endpoint stays halted: re-enumerating the device (try %u of %u)",
+				s_nReEnumTries, MaxReEnums);
+
+	pDevice->RemoveDevice ();			// deletes pDevice and *this*
+
+	if (pHub != 0)
+	{
+		pHub->ReScanDevices ();
+	}
+	else
+	{
+		pRootPort->ReScanDevices ();
+	}
+
+	return TRUE;
+#else
+	return FALSE;
+#endif
+}
+
+unsigned CUSBHIDDevice::GetReEnumCount (void)
+{
+	return s_nReEnums;
+}
