+unsigned CXHCIEndpoint::DropURBs (void)
+{
+	m_SpinLock.Acquire ();
+	unsigned nDropped = m_nURBCount;
+	while (m_nURBCount > 0)
+	{
+		m_pURB[m_nURBHead] = 0;
+		m_nURBHead = (m_nURBHead + 1) % XHCI_EP_MAX_URBS;
+		m_nURBCount--;
+	}
+	m_SpinLock.Release ();
+
+	return nDropped;
+}
