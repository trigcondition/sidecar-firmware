diff -ruN a/include/circle/usb/usbmidihost.h b/include/circle/usb/usbmidihost.h
--- a/include/circle/usb/usbmidihost.h
+++ b/include/circle/usb/usbmidihost.h
@@ -71,6 +71,11 @@
 	u8 *m_pTxBuffer = 0;			// one transfer's, written only while none is in flight
 	volatile boolean m_bTxBusy = FALSE;
 	volatile boolean m_bTxFailed = FALSE;
+
+	// circle-usb-urb-free.patch: the URBs in flight, freed by the destructor. A function is deleted by ~CUSBDevice, after
+	// ~CXHCIUSBDevice has disabled and freed the slot, so the controller completes neither of them any more.
+	CUSBRequest * volatile m_pRxURB = 0;
+	CUSBRequest * volatile m_pTxURB = 0;
 };
 
 #endif
diff -ruN a/include/circle/usb/usbrequest.h b/include/circle/usb/usbrequest.h
