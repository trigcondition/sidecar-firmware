+++ b/include/circle/usb/usbrequest.h
@@ -89,6 +89,12 @@
 	boolean m_bCompleteOnNAK;
 	boolean m_bCompleteImmediately;
 
+public:
+	// circle-usb-urb-free.patch: the instances the class allocator holds out now and at most since boot (its limit is the
+	// host's reservation: XHCI_CONFIG_MAX_REQUESTS on a Pi 4, LogPanic past it); objects on the stack are not counted
+	static unsigned GetHeapInstances (void);
+	static unsigned GetHeapInstancesPeak (void);
+
 	DECLARE_CLASS_ALLOCATOR
 };
 
