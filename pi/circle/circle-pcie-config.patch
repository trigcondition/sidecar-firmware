+	// circle-pcie-config: one config space dword (nWhere & ~3, up to 0xffc) of the root complex (nBus 0) or of the device
+	// at nSlot/nFunc behind it (nBus 1), read (~0 when there is no host bridge) or written (FALSE then); main loop only
+	static u32 ConfigRead (unsigned nBus, unsigned nSlot, unsigned nFunc, unsigned nWhere);
+	static boolean ConfigWrite (unsigned nBus, unsigned nSlot, unsigned nFunc, unsigned nWhere, u32 nValue);
+	// the offset of a capability in that config space (0: none)
