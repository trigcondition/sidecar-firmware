diff -ruN a/lib/bcmpciehostbridge.cpp b/lib/bcmpciehostbridge.cpp
--- a/lib/bcmpciehostbridge.cpp	2026-11-24 13:17:49.833546868 +0000
+++ b/lib/bcmpciehostbridge.cpp	2026-11-24 13:17:49.866954204 +0000
@@ -346,7 +346,43 @@
 
 boolean CBcmPCIeHostBridge::EnableDevice (u32 nClassCode, unsigned nSlot, unsigned nFunc)
 {
-	return !enable_device (nClassCode, nSlot, nFunc);
+	const boolean bOK = !enable_device (nClassCode, nSlot, nFunc);
+	if (bOK && s_pConfig == 0) s_pConfig = this;	// circle-pcie-config
+	return bOK;
+}
+
+// circle-pcie-config (the index register is written for a bus 1 access, as at init)
+CBcmPCIeHostBridge *CBcmPCIeHostBridge::s_pConfig = 0;
+
+u32 CBcmPCIeHostBridge::ConfigRead (unsigned nBus, unsigned nSlot, unsigned nFunc, unsigned nWhere)
+{
+	CBcmPCIeHostBridge *p = s_pConfig;
+	if (p == 0 || nBus > 1 || nSlot >= 32 || nFunc >= 8 || nWhere > 0xffc) return ~0U;
+	const uintptr conf = p->pcie_map_conf (nBus, PCI_DEVFN (nSlot, nFunc), nWhere & ~3U);
+	return conf == 0 ? ~0U : read32 (conf);
+}
+
+boolean CBcmPCIeHostBridge::ConfigWrite (unsigned nBus, unsigned nSlot, unsigned nFunc, unsigned nWhere, u32 nValue)
+{
+	CBcmPCIeHostBridge *p = s_pConfig;
+	if (p == 0 || nBus > 1 || nSlot >= 32 || nFunc >= 8 || nWhere > 0xffc) return FALSE;
+	const uintptr conf = p->pcie_map_conf (nBus, PCI_DEVFN (nSlot, nFunc), nWhere & ~3U);
+	if (conf == 0) return FALSE;
+	write32 (conf, nValue);
+	return TRUE;
+}
+
+unsigned CBcmPCIeHostBridge::FindCapability (unsigned nBus, unsigned nSlot, unsigned nFunc, unsigned nCapID)
+{
+	if (!((ConfigRead (nBus, nSlot, nFunc, 4) >> 16) & PCI_STATUS_CAP_LIST)) return 0;
+	unsigned nPtr = ConfigRead (nBus, nSlot, nFunc, PCI_CAPABILITY_LIST) & 0xfc;
+	for (unsigned n = 0; nPtr >= 0x40 && n < 48; n++)
+	{
+		const u32 nHead = ConfigRead (nBus, nSlot, nFunc, nPtr);
+		if ((nHead & 0xff) == nCapID) return nPtr;
+		nPtr = (nHead >> 8) & 0xfc;
+	}
+	return 0;
 }
 
 #if 0
