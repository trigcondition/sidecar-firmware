+unsigned CXHCIEndpoint::StopAndDrop (void)
+{
+	if (   m_bValid
+	    && m_pDevice != 0
+	    && m_pXHCIDevice != 0
+	    && XHCI_IS_ENDPOINTID (m_uchEndpointID)
+	    && m_pDevice->GetSlotID () != 0)		// circle-xhci-slotgone
+	{
+		m_pXHCIDevice->GetCommandManager ()->StopEndpoint (m_pDevice->GetSlotID (), m_uchEndpointID);
+	}
+
+	return DropURBs ();
+}
