    "card": "node scripts/card.mjs"
  },
  "dependencies": {
    "vue": "^3.5.45",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@fontsource/doto": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^6.0.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.14",
    "ws": "^8.22.1"
  }
}
