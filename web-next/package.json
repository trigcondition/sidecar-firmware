{
  "name": "sidecar-web-next",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The Sidecar's next web UI (Vue 3 + Vite + TypeScript) over the /ws WebSocket API (docs/web-ws.md)",
  "scripts": {
    "dev": "vite",
    "mock": "node mock/server.mjs",
    "build": "vue-tsc --noEmit && vite build",
